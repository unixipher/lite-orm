INSERT INTO public.users (email, name, active)
VALUES ('alice@example.com', 'Alice Vance', true)
ON CONFLICT (email) DO NOTHING;

INSERT INTO public.posts (title, content, published, author_id)
SELECT 'Getting Started with LiteORM', 'LiteORM makes PostgreSQL in Rust delightful.', true, id
FROM public.users
WHERE email = 'alice@example.com'
  AND NOT EXISTS (
    SELECT 1 FROM public.posts WHERE title = 'Getting Started with LiteORM'
  );
